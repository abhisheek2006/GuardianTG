# ─── Core ─────────────────────────────────────────────────────────────
# Get this from @BotFather
BOT_TOKEN=

# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net
# Database name inside MongoDB
MONGO_DATABASE=guardiantg

# Redis (state, rate limiting, captcha, raid tracking)
REDIS_URL=redis://redis:6379/0

# Telegram user id of the bot owner (global admin)
OWNER_ID=
# Extra trusted user ids, comma separated (optional)
SUDO_IDS=

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ─── Defaults ────────────────────────────────────────────────────────
DEFAULT_WARN_LIMIT=3
DEFAULT_MUTE_DURATION=600

CAPTCHA_TIMEOUT=120
CAPTCHA_MAX_ATTEMPTS=3

RATE_LIMIT=20
RATE_WINDOW=10

FLOOD_LIMIT=10
FLOOD_WINDOW=10

RAID_THRESHOLD=30
RAID_WINDOW=60

SPAM_SCORE_THRESHOLD=10

# ─── Web Dashboard (optional) ────────────────────────────────────────
WEB_DASHBOARD_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_SECRET=

# ─── Data retention ──────────────────────────────────────────────────
LOG_RETENTION_DAYS=30